      {
        "id": "home-en",
        "slug": "home",
        "locale": "en",
        "status": "published",
        "data": {
          "title": "Atelier 4",
          "excerpt": "A new place for young people to explore Jesus and art together. Growing out of Kunstenkamp, with room for your ideas.",
          "layout": [
            {
              "_type": "hero",
              "_version": 1,
              "_key": "hero",
              "anchor": "intro",
              "theme": "paper",
              "eyebrow": "Jesus × art × you",
              "heading": "Faith.\nArt.\nTogether.",
              "text": "A new place for young people to explore Jesus and art together. Growing out of Kunstenkamp, with room for your ideas.",
              "button_label": "Discover our plans",
              "button_url": "#events",
              "secondary_label": "Join in",
              "secondary_url": "#community"
            },
            {
              "_type": "statement",
              "_version": 1,
              "_key": "mission",
              "anchor": "over",
              "theme": "cobalt",
              "eyebrow": "This is Atelier 4",
              "heading": "Room to\ncreate.",
              "text": "Art can connect us, ask questions and give our faith a voice. At Atelier 4, we want to bring young Christians together through art nights and creative encounters. A place to make, discover and honour God together."
            },
            {
              "_type": "features",
              "_version": 1,
              "_key": "disciplines",
              "anchor": "kunst",
              "theme": "paper",
              "eyebrow": "There is room for you",
              "heading": "What do you make?",
              "items": [
                {
                  "heading": "Music",
                  "text": "From a camp song to a new sound. Play, sing and listen together."
                },
                {
                  "heading": "Visual art",
                  "text": "Painting, photography, installations. Give your ideas a shape."
                },
                {
                  "heading": "Words & movement",
                  "text": "Poetry, stories, theatre and dance. Share what moves you."
                }
              ]
            },
            {
              "_type": "events",
              "_version": 1,
              "_key": "events",
              "anchor": "events",
              "theme": "yellow",
              "eyebrow": "Our first ideas",
              "heading": "Something\nis coming.",
              "text": "We are shaping our first events. Everything is still in preparation: dates, venues and registration will follow.",
              "limit": 6
            },
            {
              "_type": "form",
              "_version": 1,
              "_key": "community",
              "anchor": "community",
              "theme": "orange",
              "eyebrow": "Help shape it",
              "heading": "Your place\nat the table.",
              "text": "Whether you make music, draw, dance, write or enjoy helping behind the scenes: we would love to meet you. Tell us what excites you.",
              "form_type": "community"
            },
            {
              "_type": "faq",
              "_version": 1,
              "_key": "faq",
              "anchor": "vragen",
              "theme": "paper",
              "heading": "A question?",
              "items": [
                {
                  "heading": "Do I need to be an artist already?",
                  "text": "No. Enthusiasm and curiosity are enough. There is room to learn and explore together."
                },
                {
                  "heading": "How is this connected to Kunstenkamp?",
                  "text": "Atelier 4 is growing out of the Kunstenkamp community. We want that connection and creativity to keep going throughout the year."
                },
                {
                  "heading": "When is the first event?",
                  "text": "We are still planning. Leave your details and tell us you would like to receive updates."
                }
              ]
            }
          ],
          "content": []
        },
        "translationOf": "home"
      },
