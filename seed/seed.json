  "content": {
    "pages": [
      {
        "id": "home",
        "slug": "home",
        "locale": "nl",
        "status": "published",
        "data": {
          "title": "Atelier 4",
          "excerpt": "Een nieuwe plek voor jonge mensen die Jezus en kunst samen willen ontdekken. Vanuit Kunstenkamp, met ruimte voor jouw ideeën.",
          "layout": [
            {
              "_type": "hero",
              "_version": 1,
              "_key": "hero",
              "anchor": "intro",
              "theme": "paper",
              "eyebrow": "Jezus × kunst × jij",
              "heading": "Geloof.\nKunst.\nSamen.",
              "text": "Een nieuwe plek voor jonge mensen die Jezus en kunst samen willen ontdekken. Vanuit Kunstenkamp, met ruimte voor jouw ideeën.",
              "button_label": "Ontdek de plannen",
              "button_url": "#events",
              "secondary_label": "Doe mee",
              "secondary_url": "#community"
            },
            {
              "_type": "statement",
              "_version": 1,
              "_key": "mission",
              "anchor": "over",
              "theme": "cobalt",
              "eyebrow": "Dit is Atelier 4",
              "heading": "Ruimte om\nte creëren.",
              "text": "Kunst kan verbinden, vragen stellen en ons geloof een stem geven. Met Atelier 4 willen we kunstavonden en ontmoetingen organiseren voor jonge christenen. Een plek om samen te maken, te ontdekken en God te eren."
            },
            {
              "_type": "features",
              "_version": 1,
              "_key": "disciplines",
              "anchor": "kunst",
              "theme": "paper",
              "eyebrow": "Er is plek voor jou",
              "heading": "Wat maak jij?",
              "items": [
                {
                  "heading": "Muziek",
                  "text": "Van kamplied tot een nieuw geluid. Samen spelen, zingen en luisteren."
                },
                {
                  "heading": "Beeld",
                  "text": "Schilderkunst, fotografie, installaties. Geef jouw ideeën een vorm."
                },
                {
                  "heading": "Woord & beweging",
                  "text": "Poëzie, verhalen, theater en dans. Vertel wat je raakt."
                }
              ]
            },
            {
              "_type": "events",
              "_version": 1,
              "_key": "events",
              "anchor": "events",
              "theme": "yellow",
              "eyebrow": "De eerste ideeën",
              "heading": "Er komt\niets aan.",
              "text": "We bouwen aan onze eerste events. Alles is nog in voorbereiding: data, locaties en inschrijvingen volgen.",
              "limit": 6
            },
            {
              "_type": "form",
              "_version": 1,
              "_key": "community",
              "anchor": "community",
              "theme": "orange",
              "eyebrow": "Bouw mee",
              "heading": "Jouw plek\naan tafel.",
              "text": "Of je nu muziek maakt, tekent, danst, schrijft of graag praktisch helpt: we leren je graag kennen. Laat weten waar jij enthousiast van wordt.",
              "form_type": "community"
            },
            {
              "_type": "faq",
              "_version": 1,
              "_key": "faq",
              "anchor": "vragen",
              "theme": "paper",
              "heading": "Nog een vraag?",
              "items": [
                {
                  "heading": "Moet ik al kunstenaar zijn?",
                  "text": "Nee. Je enthousiasme en nieuwsgierigheid zijn genoeg. Er is ruimte om te leren en samen te ontdekken."
                },
                {
                  "heading": "Wat is de link met Kunstenkamp?",
                  "text": "Atelier 4 groeit vanuit de Kunstenkamp-community. We willen die verbinding en creativiteit ook doorheen het jaar verder laten leven."
                },
                {
                  "heading": "Wanneer is het eerste event?",
                  "text": "We zijn nog volop aan het plannen. Laat je gegevens achter en geef aan dat je updates wilt ontvangen."
                }
              ]
            }
          ],
          "content": []
        }
      },
      {
