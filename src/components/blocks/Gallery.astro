---
import { Image } from "emdash/ui";
import type { SectionBlock } from "../../lib/blocks";
import { sectionId, themeClass } from "../../lib/blocks";
interface Props {
  value: SectionBlock;
}
const { value } = Astro.props;
---

<section id={sectionId(value)} class:list={["section", themeClass(value)]}>
  <div class="container">
    <span class="eyebrow">{value.eyebrow}</span>
    <h2>{value.heading}</h2>
    <p>{value.text}</p>
    <div class="gallery-grid">
      {value.items?.map((item) => (
        <figure>
          {item.image && <Image image={item.image} />}{" "}
          {item.caption && <figcaption>{item.caption}</figcaption>}
        </figure>
      ))}
    </div>
  </div>
</section>
