---
import type { SectionBlock } from "../../lib/blocks";
import { sectionId, themeClass } from "../../lib/blocks";
interface Props {
  value: SectionBlock;
}
const { value } = Astro.props;
const Heading = value._heading === 1 ? "h1" : "h2";
---

<section id={sectionId(value)} class:list={["section", themeClass(value)]}>
  <div class="container">
    <Heading class="page-section-title">{value.heading}</Heading>
    {value.text && <p>{value.text}</p>}
    <div class="features-grid">
      {value.items?.map((item) => (
        <article class="feature-card">
          <h3>{item.heading}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
