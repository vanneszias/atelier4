---
import { Image } from "emdash/ui";
import type { SectionBlock } from "../../lib/blocks";
import { sectionId, themeClass } from "../../lib/blocks";
import { safeUrl } from "../../i18n";
interface Props {
  value: SectionBlock;
}
const { value } = Astro.props;
const Heading = value._heading === 2 ? "h2" : "h1";
---

<section id={sectionId(value)} class:list={["hero", themeClass(value)]}>
  <div class="container">
    <div class="grid">
      <div class="hero-copy">
        <span class="eyebrow">{value.eyebrow}</span>
        <Heading class="hero-title" style="white-space:pre-line">
          {value.heading}
        </Heading>
        <p>{value.text}</p>
        <div class="actions">
          {value.button_label && (
            <a class="button" href={safeUrl(value.button_url)}>
              {value.button_label}
            </a>
          )}
          {value.secondary_label && (
            <a class="button secondary" href={safeUrl(value.secondary_url)}>
              {value.secondary_label}
            </a>
          )}
        </div>
      </div>
      <div class="hero-art" aria-hidden={!value.image}>
        <>
          {value.image ? (
            <Image image={value.image} />
          ) : (
            <img src="/brand/mark.svg" alt="" width="430" height="370" />
          )}
        </>
      </div>
    </div>
    <div class="hero-foot">
      <span>Atelier 4</span>
      <span>Kunstenkamp community</span>
    </div>
  </div>
</section>
