---
import { Image } from "emdash/ui";
import type { SectionBlock } from "../../lib/blocks";
import { sectionId, themeClass } from "../../lib/blocks";
import { safeUrl, localeFromPath } from "../../i18n";
interface Props {
  value: SectionBlock;
}
const { value } = Astro.props;
const Heading = value._heading === 2 ? "h2" : "h1";
const locale = localeFromPath(Astro.url.pathname);
const lines = (value.heading || "").split("\n");
---

<section id={sectionId(value)} class:list={["hero", themeClass(value)]}>
  <div class:list={["container", "hero-poster", { "has-image": !!value.image }]}>
    <div class="hero-headline">
      <Heading class="hero-title">
        {lines.map((line) => <span>{line}</span>)}
      </Heading>
    </div>
    {value.image && <div class="hero-art"><Image image={value.image} /></div>}
    <div class="hero-copy">
      {value.text && <p>{value.text}</p>}
      <div class="actions">
        {value.button_label && <a class="button" href={safeUrl(value.button_url)}>{value.button_label}</a>}
        {value.secondary_label && <a class="button secondary" href={safeUrl(value.secondary_url)}>{value.secondary_label}</a>}
      </div>
    </div>
    <div class="hero-disciplines" aria-label={locale === "nl" ? "Onze vier kunstvormen" : "Our four art forms"}>
      <span>{locale === "nl" ? "Muziek" : "Music"}</span><span>Atelier</span><span>Drama</span><span>{locale === "nl" ? "Dans" : "Dance"}</span>
    </div>
  </div>
</section>
