---
import { PortableText } from "emdash/ui";
import type { SectionBlock } from "../../lib/blocks";
import { sectionId, themeClass } from "../../lib/blocks";
import { safeUrl } from "../../i18n";
interface Props {
  value: SectionBlock;
}
const { value } = Astro.props;
const Heading = value._heading === 1 ? "h1" : "h2";
---

<section id={sectionId(value)} class:list={["section", "statement-section", themeClass(value)]}>
  <div class="container statement-panel grid">
    <div>
      <Heading class="page-section-title" style="white-space:pre-line">{value.heading}</Heading>
    </div>
    <div>
      {value.text && <p>{value.text}</p>}
      {value.content && <PortableText value={value.content} />}{" "}
      {value.button_label && (
        <a class="button" href={safeUrl(value.button_url)}>
          {value.button_label}
        </a>
      )}
    </div>
  </div>
</section>
