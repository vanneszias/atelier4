---
import { PortableText } from "emdash/ui";
import type { SectionBlock } from "../../lib/blocks";
import { sectionId, themeClass } from "../../lib/blocks";
import { safeUrl } from "../../i18n";
interface Props {
  value: SectionBlock;
}
const { value } = Astro.props;
---

<section id={sectionId(value)} class:list={["section", themeClass(value)]}>
  <div class="container grid">
    <div>
      <span class="eyebrow">{value.eyebrow}</span>
      <h2 style="white-space:pre-line">{value.heading}</h2>
    </div>
    <div>
      <p>{value.text}</p>
      {value.content && <PortableText value={value.content} />}{" "}
      {value.button_label && (
        <a class="button" href={safeUrl(value.button_url)}>
          {value.button_label}
        </a>
      )}
    </div>
  </div>
</section>
