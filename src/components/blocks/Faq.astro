---
import type { SectionBlock } from "../../lib/blocks";
import { sectionId, themeClass } from "../../lib/blocks";
interface Props {
  value: SectionBlock;
}
const { value } = Astro.props;
const Heading = value._heading === 1 ? "h1" : "h2";
---

<section
  id={sectionId(value)}
  class:list={["section", "faq", themeClass(value)]}
>
  <div class="container faq-layout">
    <div class="faq-heading">
    <Heading class="page-section-title">{value.heading}</Heading>
    {value.text && <p>{value.text}</p>}
    </div>
    <div class="faq-items">
    {value.items?.map((item) => (
      <details>
        <summary>{item.heading}</summary>
        <p>{item.text}</p>
      </details>
    ))}
    </div>
  </div>
</section>
