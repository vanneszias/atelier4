---
import { getEmDashCollection } from "emdash";
import ContentCard from "../ContentCard.astro";
import type { SectionBlock } from "../../lib/blocks";
import { sectionId, themeClass } from "../../lib/blocks";
import { localeFromPath, messages } from "../../i18n";
interface Props {
  value: SectionBlock;
}
const { value } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const collection = value._type === "news" ? "posts" : value._type;
const { entries, cacheHint } = await getEmDashCollection(collection, {
  locale,
  limit: Math.min(24, Math.max(1, value.limit || 6)),
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const Heading = value._heading === 1 ? "h1" : "h2";
---

<section id={sectionId(value)} class:list={["section", "collection-section", themeClass(value)]}>
  <div class="container">
    <div class="split-heading">
      <Heading class="page-section-title" style="white-space:pre-line">{value.heading}</Heading>
      {value.text && <p>{value.text}</p>}
    </div>
    <div class:list={["grid", "collection-grid", { "single-card": entries.length === 1 }]}>
      {entries.map((entry) => (
        <ContentCard entry={entry} collection={collection} />
      ))}
    </div>
    {!entries.length && <p>{messages[locale].empty}</p>}
  </div>
</section>
