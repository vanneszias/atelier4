---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import ContentCard from "../../components/ContentCard.astro";
import { messages } from "../../i18n";
const t = messages.nl;
const { entries, error, nextCursor, cacheHint } = await getEmDashCollection(
  "events",
  {
    locale: "nl",
    limit: 12,
    cursor: Astro.url.searchParams.get("cursor") || undefined,
    orderBy: { published_at: "desc" },
  },
);
if (error) return new Response("Content unavailable", { status: 503 });
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base title={t.events}>
  <section class="container article">
    <span class="eyebrow">Atelier 4</span>
    <h1>{t.events}</h1>
    <div class="grid">
      {entries.map((entry) => (
        <ContentCard entry={entry} collection="events" />
      ))}
    </div>
    {!entries.length && <p>{t.empty}</p>}
    {nextCursor && (
      <a class="button" href={"?cursor=" + encodeURIComponent(nextCursor)}>
        {t.next}
      </a>
    )}
  </section>
</Base>
